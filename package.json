{
  "name": "precise-colors",
  "version": "2.0.0",
  "private": false,
  "description": "Color conversions and Delta E functions without intermediate rounding",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/king8fisher/precise-colors.git"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.lib.json",
    "test": "bun test --timeout 60000 ./src ./.github/scripts",
    "test:watch": "bun test --timeout 60000 --watch ./src ./.github/scripts",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "keywords": [
    "color",
    "conversion",
    "deltaE",
    "CIEDE2000",
    "oklab",
    "oklch",
    "lab",
    "precision"
  ],
  "author": "Anton Veretennikov (king8fisher)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "latest",
    "@types/color-name": "^2.0.0",
    "color-name": "^2.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-no-in-array": "^1.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "type": "module"
}
